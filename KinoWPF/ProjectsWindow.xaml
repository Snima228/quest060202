<Window x:Class="KinoWPF.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проекты" Height="780" Width="650"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Статус:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cb_FilterStatus" Width="200" Margin="10,0,0,0"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="CbFilterStatus_SelectionChanged"/>
                <Button x:Name="btn_ClearFilter" Content="Сбросить" Width="90"
                        Margin="10,0,0,0" Click="BtnClearFilter_Click"/>
            </StackPanel>

            <DataGrid x:Name="dg_Projects" Height="250"
          AutoGenerateColumns="False" IsReadOnly="True"
          SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}"   Width="*"/>
                    <DataGridTextColumn Header="Жанр"     Binding="{Binding Genre}"  Width="*"/>
                    <DataGridTextColumn Header="Бюджет"   Binding="{Binding Budget, StringFormat={}{0:N0}}" Width="Auto"/>
                    <DataGridTextColumn Header="Дата начала" Binding="{Binding DateStart, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto"/>
                    <DataGridTextColumn Header="Дата окончания" Binding="{Binding DateEnd, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto"/>
                    <DataGridTextColumn Header="Статус"   Binding="{Binding Status}" Width="Auto"/>
                    <DataGridTextColumn Header="Целевая аудитория" Binding="{Binding TargetAudience}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                <Button x:Name="btn_Add"    Content="Добавить"      Width="100" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="btn_Edit"   Content="Редактировать" Width="120" Margin="0,0,10,0" Click="BtnEdit_Click"/>
                <Button x:Name="btn_Delete" Content="Удалить"       Width="100" Click="BtnDelete_Click"/>
            </StackPanel>

            <StackPanel x:Name="panelForm" Visibility="Collapsed">
                <TextBlock x:Name="lbl_FormTitle" Text="Данные проекта"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Название *"/>
                <TextBox x:Name="tb_Name" Margin="0,2,0,10"/>

                <TextBlock Text="Жанр"/>
                <ComboBox x:Name="cb_Genre" DisplayMemberPath="Name"
                          SelectedValuePath="Id" Margin="0,2,0,10"/>

                <TextBlock Text="Бюджет *"/>
                <TextBox x:Name="tb_Budget" Margin="0,2,0,10"/>

                <TextBlock Text="Дата начала *"/>
                <DatePicker x:Name="dp_Start" Margin="0,2,0,10"/>

                <TextBlock Text="Дата окончания *"/>
                <DatePicker x:Name="dp_End" Margin="0,2,0,10"/>

                <TextBlock Text="Статус *"/>
                <ComboBox x:Name="cb_Status" DisplayMemberPath="Name"
                          SelectedValuePath="Id" Margin="0,2,0,10"/>

                <TextBlock Text="Целевая аудитория"/>
                <TextBox x:Name="tb_Audience" Margin="0,2,0,15"/>

                <TextBlock x:Name="lbl_ValidationError" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_Save"   Content="Сохранить" Width="90" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button x:Name="btn_Cancel" Content="Отмена"    Width="90" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>