<Window x:Class="KinoWPF.EmployesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудники" Height="1020" Width="700"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,-6">
        <StackPanel Margin="15" Height="985">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Поиск по фамилии:" VerticalAlignment="Center"/>
                <TextBox x:Name="tb_Search" Width="220" Margin="10,0,0,0"
                         TextChanged="TxtSearch_TextChanged"/>
            </StackPanel>

            <DataGrid x:Name="dg_Employees" Height="250"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Фамилия"        Binding="{Binding LastName}"       Width="*"/>
                    <DataGridTextColumn Header="Имя"            Binding="{Binding FirstName}"      Width="*"/>
                    <DataGridTextColumn Header="Должность"      Binding="{Binding Specialization}" Width="*"/>
                    <DataGridTextColumn Header="Телефон"        Binding="{Binding Phone}"          Width="*"/>
                    <DataGridTextColumn Header="Почта"        Binding="{Binding Email}"          Width="*"/>
                    <DataGridTextColumn Header="Ставка"         Binding="{Binding Rate, StringFormat={}{0:N0}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                <Button x:Name="btn_Add"    Content="Добавить"     Width="100" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="btn_Edit"   Content="Редактировать" Width="120" Margin="0,0,10,0" Click="BtnEdit_Click"/>
                <Button x:Name="btn_Delete" Content="Удалить"      Width="100" Click="BtnDelete_Click"/>
            </StackPanel>

            <StackPanel x:Name="panelForm" Visibility="Collapsed">
                <TextBlock x:Name="lbl_FormTitle" Text="Данные сотрудника"
               FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Фамилия *"/>
                <TextBox x:Name="tb_SecondName" Margin="0,2,0,10"/>

                <TextBlock Text="Имя *"/>
                <TextBox x:Name="tb_Name" Margin="0,2,0,10"/>

                <TextBlock Text="Должность *"/>
                <ComboBox x:Name="cb_Post" DisplayMemberPath="Name"
              SelectedValuePath="Id" Margin="0,2,0,10"/>

                <TextBlock Text="Телефон *"/>
                <TextBox x:Name="tb_Phone" Margin="0,2,0,10"/>

                <TextBlock Text="Email *"/>
                <TextBox x:Name="tb_Email" Margin="0,2,0,10"/>

                <TextBlock Text="Ставка *"/>
                <TextBox x:Name="tb_Bet" Margin="0,2,0,15"/>

                <Separator Margin="0,5,0,10"/>
                <TextBlock Text="Логин (для входа в систему) *" FontWeight="SemiBold"/>
                <TextBox x:Name="tb_Login" Margin="0,2,0,10"/>

                <TextBlock Text="Пароль *" FontWeight="SemiBold"/>
                <TextBox x:Name="tb_Password" Margin="0,2,0,15"/>

                <Image x:Name="ImagePhoto" Width="120" Height="120" Stretch="Uniform" Margin="0,0,0,5"/>
                <Button x:Name="btnDownloadPhoto" Content="Загрузить фото" Click="BtnDownloadPhoto_Click" Margin="0,0,0,15"/>

                <TextBlock x:Name="lbl_ValidationError" Foreground="Red"
               TextWrapping="Wrap" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_Save"   Content="Сохранить" Width="90" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button x:Name="btn_Cancel" Content="Отмена"    Width="90" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>