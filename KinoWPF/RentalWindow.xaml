<Window x:Class="KinoWPF.RentalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прокат" Height="700" Width="700"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <DataGrid x:Name="dg_Rental" Height="230"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Проект"       Binding="{Binding ProjectName}" Width="*"/>
                    <DataGridTextColumn Header="Дата выхода"  Binding="{Binding ReleaseDate, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto"/>
                    <DataGridTextColumn Header="Кинотеатры"   Binding="{Binding TheaterCount}" Width="Auto"/>
                    <DataGridTextColumn Header="Сборы"        Binding="{Binding BoxOffice, StringFormat={}{0:N0}}" Width="*"/>
                    <DataGridTextColumn Header="Рейтинг"      Binding="{Binding Rating, StringFormat={}{0:F1}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                <Button x:Name="btn_Add"    Content="Добавить"      Width="100" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="btn_Edit"   Content="Редактировать" Width="120" Margin="0,0,10,0" Click="BtnEdit_Click"/>
                <Button x:Name="btn_Delete" Content="Удалить"       Width="100" Click="BtnDelete_Click"/>
            </StackPanel>

            <StackPanel x:Name="panelForm" Visibility="Collapsed">
                <TextBlock x:Name="lbl_FormTitle" Text="Запись о прокате"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Проект *"/>
                <ComboBox x:Name="cb_Project" DisplayMemberPath="Name"
                          SelectedValuePath="Id" Margin="0,2,0,10"/>

                <TextBlock Text="Дата выхода *"/>
                <DatePicker x:Name="dp_ReleaseDate" Margin="0,2,0,10"/>

                <TextBlock Text="Количество кинотеатров *"/>
                <TextBox x:Name="tb_Theaters" Margin="0,2,0,10"/>

                <TextBlock Text="Сборы"/>
                <TextBox x:Name="tb_BoxOffice" Margin="0,2,0,10"/>

                <TextBlock Text="Рейтинг (0–10) *"/>
                <TextBox x:Name="tb_Rating" Margin="0,2,0,15"/>

                <TextBlock x:Name="lbl_ValidationError" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_Save"   Content="Сохранить" Width="90" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button x:Name="btn_Cancel" Content="Отмена"    Width="90" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>