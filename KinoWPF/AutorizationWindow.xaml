<Window x:Class="KinoWPF.AutorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация" Height="320" Width="360"
        WindowStartupLocation="CenterScreen" Background="#F9F9F9">
    <StackPanel Margin="20">
        <TextBlock Text="Вход в систему" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Text="Логин:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="tb_Login" Padding="6" Margin="0,0,0,15"/>

        <TextBlock Text="Пароль:" FontWeight="Bold" Margin="0,0,0,5"/>
        <TextBox x:Name="tb_Password" Padding="6" Margin="0,0,0,20"/>

        <Button x:Name="btn_Login" Content="Войти" Padding="10"
                FontWeight="Bold" Click="LoginButton_Click" Margin="0,0,0,10" IsDefault="True"/>
    </StackPanel>
</Window>