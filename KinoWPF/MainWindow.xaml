<Window x:Class="KinoWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Киностудия" Height="500" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Grid Grid.Row="0" Margin="15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                <TextBlock Text="Пользователь: " Foreground="#666666"/>
                <TextBlock x:Name="tb_UserName" FontWeight="Bold" Text="—"/>
            </StackPanel>

            <Button x:Name="btn_Logout" Content="Выйти"
                    HorizontalAlignment="Right" Padding="10,5"
                    Click="LogoutButton_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="400" HorizontalAlignment="Center" Margin="0,20,0,20">
                <TextBlock Text="Главное меню" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <Button x:Name="btn_Employees" Content="Сотрудники"       Margin="0,5" Padding="10" Click="EmployeesButton_Click"/>
                <Button Content="Проекты"          Margin="0,5" Padding="10" Click="ProjectsButton_Click"/>
                <Button Content="Площадки"         Margin="0,5" Padding="10" Click="LocationsButton_Click"/>
                <Button Content="Съёмочная группа" Margin="0,5" Padding="10" Click="CrewButton_Click"/>
                <Button Content="График съёмок"    Margin="0,5" Padding="10" Click="ScheduleButton_Click"/>
                <Button Content="Затраты"          Margin="0,5" Padding="10" Click="CostsButton_Click"/>
                <Button Content="Прокат"           Margin="0,5" Padding="10" Click="RentalButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>