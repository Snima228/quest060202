<Window x:Class="KinoWPF.AreaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Площадки" Height="650" Width="600"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <DataGrid x:Name="dg_Areas" Height="230"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Адрес"           Binding="{Binding Address}"     Width="*"/>
                    <DataGridTextColumn Header="Тип"             Binding="{Binding Type}"        Width="*"/>
                    <DataGridTextColumn Header="Стоимость/день"  Binding="{Binding RentalPrice, StringFormat={}{0:N0}}" Width="Auto"/>
                    <DataGridTextColumn Header="Вместимость"     Binding="{Binding Capacity}"    Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                <Button x:Name="btn_Add"    Content="Добавить"      Width="100" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="btn_Edit"   Content="Редактировать" Width="120" Margin="0,0,10,0" Click="BtnEdit_Click"/>
                <Button x:Name="btn_Delete" Content="Удалить"       Width="100" Click="BtnDelete_Click"/>
            </StackPanel>

            <StackPanel x:Name="panelForm" Visibility="Collapsed">
                <TextBlock x:Name="lbl_FormTitle" Text="Данные площадки"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Город"/>
                <ComboBox x:Name="cb_City" DisplayMemberPath="Name"
                          SelectedValuePath="Id" Margin="0,2,0,10"
                          SelectionChanged="Cb_City_SelectionChanged"/>

                <TextBlock Text="Улица"/>
                <ComboBox x:Name="cb_Street" DisplayMemberPath="Name"
                          SelectedValuePath="Id" Margin="0,2,0,10"/>

                <TextBlock Text="Дом *"/>
                <TextBox x:Name="tb_Home" Margin="0,2,0,10"/>

                <TextBlock Text="Тип площадки *"/>
                <ComboBox x:Name="cb_TypeArea" DisplayMemberPath="Name"
                          SelectedValuePath="Id" Margin="0,2,0,10"/>

                <TextBlock Text="Стоимость аренды в день *"/>
                <TextBox x:Name="tb_RentalCost" Margin="0,2,0,10"/>

                <TextBlock Text="Вместимость *"/>
                <TextBox x:Name="tb_Capacity" Margin="0,2,0,15"/>

                <TextBlock x:Name="lbl_ValidationError" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_Save"   Content="Сохранить" Width="90" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button x:Name="btn_Cancel" Content="Отмена"    Width="90" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>