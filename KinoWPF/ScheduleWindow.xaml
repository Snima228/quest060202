<Window x:Class="KinoWPF.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="График съёмок" Height="780" Width="700"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Проект:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cb_FilterProject" Width="180" Margin="5,0,15,0"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="Filter_Changed"/>

                <TextBlock Text="Дата:" VerticalAlignment="Center"/>
                <DatePicker x:Name="dp_FilterDate" Width="140" Margin="5,0,15,0"
                            SelectedDateChanged="Filter_Changed"/>

                <Button x:Name="btn_ClearFilter" Content="Сбросить"
                        Width="90" Click="BtnClearFilter_Click"/>
            </StackPanel>

            <DataGrid x:Name="dg_Schedule" Height="230"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата"      Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="Auto"/>
                    <DataGridTextColumn Header="Время"     Binding="{Binding Time}"           Width="Auto"/>
                    <DataGridTextColumn Header="Проект"    Binding="{Binding ProjectName}"    Width="*"/>
                    <DataGridTextColumn Header="Площадка"  Binding="{Binding VenueAddress}"   Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,15">
                <Button x:Name="btn_Add"    Content="Добавить"      Width="100" Margin="0,0,10,0" Click="BtnAdd_Click"/>
                <Button x:Name="btn_Edit"   Content="Редактировать" Width="120" Margin="0,0,10,0" Click="BtnEdit_Click"/>
                <Button x:Name="btn_Delete" Content="Удалить"       Width="100" Click="BtnDelete_Click"/>
            </StackPanel>

            <StackPanel x:Name="panelForm" Visibility="Collapsed">
                <TextBlock x:Name="lbl_FormTitle" Text="Съёмочный день"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Дата *"/>
                <DatePicker x:Name="dp_Date" Margin="0,2,0,10"/>

                <TextBlock Text="Время *"/>
                <TextBox x:Name="tb_Time" Margin="0,2,0,10"
                         ToolTip="Например: 14:30"/>

                <TextBlock Text="Проект *"/>
                <ComboBox x:Name="cb_Project" DisplayMemberPath="Name"
                          SelectedValuePath="Id" Margin="0,2,0,10"/>

                <TextBlock Text="Площадка *"/>
                <ComboBox x:Name="cb_Area" DisplayMemberPath="Address"
                          SelectedValuePath="Id" Margin="0,2,0,15"/>

                <TextBlock x:Name="lbl_ValidationError" Foreground="Red"
                           TextWrapping="Wrap" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btn_Save"   Content="Сохранить" Width="90" Margin="0,0,10,0" Click="BtnSave_Click"/>
                    <Button x:Name="btn_Cancel" Content="Отмена"    Width="90" Click="BtnCancel_Click"/>
                </StackPanel>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>